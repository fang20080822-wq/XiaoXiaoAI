# 复制为 .env 后填写；绝对不要把真实 .env 上传到公开仓库或参赛ZIP
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 请设置至少32位随机字符串
TOKEN_SECRET=请替换为随机长字符串
# 教师工作台登录密码（建议长密码，不要与其他账号共用）
ADMIN_PASSWORD=请替换为教师专用强密码
PORT=3000
# 若前后端同域部署，留空；跨域时填写唯一前端来源，例如 https://your-site.example
ALLOW_ORIGIN=
